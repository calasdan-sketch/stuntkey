# The sdist carries the tests, their helper included: setuptools adds only
# tests/test*.py by itself, and every test imports tests/_isolation.py.
include CHANGELOG.md
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
include CONTRIBUTING.md
recursive-include .github *.yml *.md
include docs/guide.md
recursive-include docs/site *.html *.css *.svg *.png *.md
recursive-include stuntkey/web *.html *.css *.svg *.png

include SECURITY.md
include docs/THREAT_MODEL.md
recursive-include scripts *.py
recursive-include packaging *.json *.js *.cmd *.yaml *.md

# The Agent Leak Benchmark: tests/test_leakbench.py imports it.
recursive-include leakbench *.py *.json *.md
